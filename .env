# 以太坊节点（推荐Infura/Alchemy，或本地节点）
ETH_NODE_URL="https://mainnet.infura.io/v3/你的Infura密钥"
# 要监听的合约地址（示例：USDC合约）
CONTRACT_ADDRESS="0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48"
# MySQL配置
MYSQL_DSN="root:12345678@tcp(127.0.0.1:3306)/eth_event?charset=utf8mb4&parseTime=True&loc=Local"
# 监听起始区块（0=从创世块开始，建议填最新区块减少同步时间）
START_BLOCK=0
# 服务端口
SERVER_PORT=8080